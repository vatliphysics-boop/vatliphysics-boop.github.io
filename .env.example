# Cấu hình mẫu cho dự án Học liệu số Vật lí Hạt nhân 12 (sao chép thành .env.local khi chạy cục bộ)

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL gốc của ứng dụng
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tùy chọn: Bật giao diện kho học liệu hợp nhất (true / false)
NEXT_PUBLIC_USE_UNIFIED_CATALOG=

# Tùy chọn: Máy chủ AI cục bộ & đường dẫn dữ liệu ngân hàng sách cục bộ
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
BOOK_BANK_DIR=

# Tùy chọn: Biến môi trường chạy kiểm thử tự động Playwright E2E
E2E_BASE_URL=http://localhost:3000
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
